---
import Layout from '../../layouts/Layout.astro';
import '../../styles/global.css';

// Get all blog posts sorted by date
const allPosts = import.meta.glob('./*.md', { eager: true }) as Record<string, any>;
const sortedPosts = Object.values(allPosts)
  .sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime());
---

<Layout title="博客 — 游戏开发者">
  <section class="page-header">
    <div class="container">
      <p class="section-label animate-slide-up">// 博客</p>
      <h1 class="animate-slide-up delay-1">想法与笔记。</h1>
      <p class="page-desc animate-slide-up delay-2">
        记录关于游戏开发、编程以及一路上学到的东西。
      </p>
    </div>
  </section>

  <section class="blog-section">
    <div class="container">
      <div class="posts-list">
        {sortedPosts.map((post, i) => {
          const date = new Date(post.frontmatter.date).toLocaleDateString('zh-CN', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          });
          return (
            <a href={post.url} class={`post-item animate-slide-up delay-${i + 1}`}>
              <time class="post-date">{date}</time>
              <h2 class="post-title">{post.frontmatter.title}</h2>
              <span class="post-arrow">→</span>
            </a>
          );
        })}
      </div>

      {sortedPosts.length === 0 && (
        <div class="empty-state animate-slide-up">
          <p>暂无文章，敬请期待！</p>
        </div>
      )}
    </div>
  </section>
</Layout>

<style>
  .page-header {
    padding-top: 140px;
    padding-bottom: 60px;
  }

  .page-header h1 {
    margin-bottom: 16px;
  }

  .page-desc {
    font-size: 1.15rem;
    color: var(--text-secondary);
    max-width: 520px;
  }

  .blog-section {
    padding-bottom: 80px;
  }

  .posts-list {
    display: flex;
    flex-direction: column;
  }

  .post-item {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 28px 0;
    border-bottom: 1px solid var(--border-subtle);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .post-item:first-child {
    border-top: 1px solid var(--border-subtle);
  }

  .post-item:hover {
    padding-left: 12px;
  }

  .post-item:hover .post-title {
    color: var(--text-primary);
  }

  .post-item:hover .post-arrow {
    opacity: 1;
    transform: translateX(0);
    color: var(--accent-blue);
  }

  .post-date {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-tertiary);
    min-width: 100px;
    flex-shrink: 0;
  }

  .post-title {
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--text-secondary);
    transition: color var(--transition-fast);
    flex: 1;
  }

  .post-arrow {
    font-size: 1.1rem;
    color: var(--text-tertiary);
    opacity: 0;
    transform: translateX(-8px);
    transition: all var(--transition-fast);
    flex-shrink: 0;
  }

  .empty-state {
    text-align: center;
    padding: 80px 0;
  }

  .empty-state p {
    color: var(--text-tertiary);
    font-size: 1.1rem;
  }

  @media (max-width: 640px) {
    .post-item {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      padding: 20px 0;
    }

    .post-arrow {
      display: none;
    }
  }
</style>
