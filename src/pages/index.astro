---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
import { projects } from '../data/projects';

const featuredProjects = projects.filter(p => p.featured);
const mainProject = featuredProjects[0];
const subProjects = featuredProjects.slice(1, 3);
---

<Layout title="DevPortfolio — Code & Design">
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container hero-container">
      <div class="hero-content animate-fade-in">
        <div class="status-badge">
          <span class="status-dot"></span> Available for new projects
        </div>
        <h1 class="hero-title">
          Building <span class="gradient-text">Digital</span><br>
          Experiences
        </h1>
        <p class="hero-description">
          I'm a Full Stack Developer & UI Designer based in Cyber City. 
          I craft high-performance websites and interactive applications with modern technologies.
        </p>
        <div class="hero-actions">
          <a href="/projects" class="btn btn-primary">View Work</a>
          <a href="/contact" class="btn btn-secondary">Contact Me</a>
        </div>
        
        <div class="tech-stack-mini">
          <span>Stack:</span>
          <div class="stack-icons">
            <span class="stack-icon" title="React">⚛️</span>
            <span class="stack-icon" title="TypeScript">TS</span>
            <span class="stack-icon" title="Astro">🚀</span>
            <span class="stack-icon" title="Tailwind">CSS</span>
          </div>
        </div>
      </div>

      <div class="hero-visual animate-fade-in delay-1">
        <div class="code-card">
          <div class="code-header">
            <div class="code-controls">
              <span></span><span></span><span></span>
            </div>
            <div class="code-title">developer.ts</div>
          </div>
          <div class="code-body">
            <div class="line"><span class="kwd">interface</span> <span class="cls">Developer</span> &#123;</div>
            <div class="line indent"><span class="prop">name</span>: <span class="str">'Alex'</span>;</div>
            <div class="line indent"><span class="prop">role</span>: <span class="str">'Full Stack'</span>;</div>
            <div class="line indent"><span class="prop">passion</span>: <span class="str">'UI/UX'</span>;</div>
            <div class="line">&#125;</div>
            <div class="line"></div>
            <div class="line"><span class="kwd">const</span> <span class="var">me</span>: <span class="cls">Developer</span> = &#123;</div>
            <div class="line indent"><span class="prop">code</span>: <span class="func">buildAwesomeThings</span>(),</div>
            <div class="line indent"><span class="prop">design</span>: <span class="func">pixelPerfect</span>(),</div>
            <div class="line">&#125;;</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Projects -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Selected <span class="gradient-text">Work</span></h2>
        <a href="/projects" class="btn-link">All Projects</a>
      </div>

      <div class="bento-grid">
        <!-- Main Project -->
        {mainProject && (
          <a href={mainProject.link || '/projects'} class="card bento-main animate-fade-in delay-1">
            <div class="card-content">
              <div class="project-meta">
                <span class="tag">Featured</span>
                {mainProject.year && <span class="year">{mainProject.year}</span>}
              </div>
              <h3>{mainProject.title}</h3>
              <p>{mainProject.description}</p>
              <div class="project-tags">
                {mainProject.tags.map(tag => <span class="tag">{tag}</span>)}
              </div>
            </div>
            <div class="card-visual visual-main">
              <!-- Abstract UI representation -->
              <div class="ui-mockup"></div>
            </div>
          </a>
        )}

        <!-- Sub Projects -->
        {subProjects.map((project, index) => (
          <a href={project.link || '/projects'} class={`card bento-sub animate-fade-in delay-${index + 2}`}>
            <div class="card-icon">{project.icon}</div>
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <div class="project-tags">
              {project.tags.slice(0, 2).map(tag => <span class="tag">{tag}</span>)}
            </div>
          </a>
        ))}

        <!-- Blog Link -->
        <a href="/blog" class="card bento-blog animate-fade-in delay-3">
          <div class="blog-content">
            <h3>Latest Thoughts</h3>
            <p>Read my articles on web development and design engineering.</p>
            <span class="arrow-icon">→</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section cta-section">
    <div class="container">
      <div class="card cta-card animate-fade-in">
        <div class="cta-content">
          <h2>Let's work together</h2>
          <p>Have a project in mind? I'm available for freelance work and collaborations.</p>
          <a href="/contact" class="btn btn-primary">Get in Touch</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero Section */
  .hero-section {
    min-height: 90vh;
    display: flex;
    align-items: center;
    padding-top: 80px;
    position: relative;
    overflow: hidden;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.2);
    border-radius: 100px;
    color: #10b981;
    font-size: 0.85rem;
    font-weight: 500;
    width: fit-content;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    background: currentColor;
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  .hero-title {
    font-size: clamp(3rem, 5vw, 4.5rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .hero-description {
    font-size: 1.15rem;
    color: var(--text-secondary);
    max-width: 500px;
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    gap: 16px;
    margin-top: 8px;
  }

  .tech-stack-mini {
    margin-top: 32px;
    display: flex;
    align-items: center;
    gap: 16px;
    color: var(--text-tertiary);
    font-size: 0.9rem;
    font-family: var(--font-mono);
  }

  .stack-icons {
    display: flex;
    gap: 12px;
  }

  .stack-icon {
    font-size: 1.2rem;
    opacity: 0.8;
    transition: opacity 0.2s;
    cursor: help;
  }

  .stack-icon:hover {
    opacity: 1;
  }

  /* Code Card */
  .code-card {
    background: #1e1e1e; /* Specific code bg */
    border-radius: 12px;
    border: 1px solid var(--border-subtle);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    overflow: hidden;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.9rem;
    transform: perspective(1000px) rotateY(-5deg) rotateX(2deg);
    transition: transform 0.4s ease;
  }

  .code-card:hover {
    transform: perspective(1000px) rotateY(0) rotateX(0);
  }

  .code-header {
    background: #252526;
    padding: 12px 16px;
    display: flex;
    align-items: center;
    gap: 16px;
    border-bottom: 1px solid #333;
  }

  .code-controls {
    display: flex;
    gap: 6px;
  }

  .code-controls span {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #555;
  }
  
  .code-controls span:nth-child(1) { background: #ff5f57; }
  .code-controls span:nth-child(2) { background: #febc2e; }
  .code-controls span:nth-child(3) { background: #28c840; }

  .code-title {
    color: #999;
    font-size: 0.8rem;
  }

  .code-body {
    padding: 24px;
    line-height: 1.6;
    color: #d4d4d4;
  }

  .line { display: block; }
  .indent { padding-left: 20px; }
  
  .kwd { color: #c586c0; } /* Purple */
  .cls { color: #4ec9b0; } /* Teal */
  .str { color: #ce9178; } /* Orange */
  .prop { color: #9cdcfe; } /* Light Blue */
  .func { color: #dcdcaa; } /* Yellow */
  .var { color: #9cdcfe; }

  /* Projects Grid */
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 40px;
  }

  .section-title {
    font-size: 2.5rem;
  }

  .bento-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: 320px 240px;
    gap: 24px;
  }

  .bento-main {
    grid-column: span 2;
    grid-row: span 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: linear-gradient(135deg, var(--bg-surface) 0%, #1a1a1a 100%);
  }

  .bento-sub {
    grid-column: span 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  
  .bento-blog {
    grid-column: span 1;
    background: var(--accent-gradient);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  
  .bento-blog h3, .bento-blog p {
    color: white;
  }

  .card-content {
    z-index: 2;
  }

  .project-meta {
    display: flex;
    justify-content: space-between;
    margin-bottom: 12px;
  }

  .project-tags {
    display: flex;
    gap: 8px;
    margin-top: 16px;
  }

  .card-icon {
    font-size: 2.5rem;
    margin-bottom: 16px;
  }

  .visual-main {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 200px;
    height: 150px;
    background: var(--bg-surface-hover);
    border-radius: 8px;
    opacity: 0.5;
    border: 1px solid var(--border-subtle);
    z-index: 1;
  }

  /* CTA */
  .cta-card {
    text-align: center;
    background: radial-gradient(circle at center, var(--bg-surface-hover) 0%, var(--bg-surface) 100%);
  }

  .cta-content {
    max-width: 500px;
    margin: 0 auto;
  }

  .cta-content h2 {
    margin-bottom: 16px;
    font-size: 2rem;
  }
  
  .cta-content p {
    margin-bottom: 32px;
    color: var(--text-secondary);
  }

  @media (max-width: 960px) {
    .hero-container {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 40px;
    }
    
    .hero-content {
      align-items: center;
    }
    
    .hero-actions {
      justify-content: center;
    }

    .bento-grid {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
    }
    
    .bento-main {
      grid-column: span 1;
      min-height: 300px;
    }
  }

  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4); }
    70% { box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
    100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
  }
</style>
