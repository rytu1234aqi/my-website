---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout title="Home — Game Developer">
  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <p class="hero-greeting animate-slide-up">Hello, World_</p>
      <h1 class="hero-title animate-slide-up delay-1">
        I build <span class="gradient-text">games</span><br />
        & interactive experiences.
      </h1>
      <p class="hero-subtitle animate-slide-up delay-2">
        Computer Science Student · Game Developer · Creative Coder
      </p>
      <div class="hero-actions animate-slide-up delay-3">
        <a href="/projects" class="btn btn-primary">View Projects</a>
        <a href="/about" class="btn btn-secondary">About Me</a>
      </div>
    </div>
  </section>

  <!-- Terminal Section -->
  <section class="section">
    <div class="container">
      <div class="terminal animate-slide-up">
        <div class="terminal-header">
          <span class="terminal-dot" style="background:#ff5f57;"></span>
          <span class="terminal-dot" style="background:#febc2e;"></span>
          <span class="terminal-dot" style="background:#28c840;"></span>
          <span class="terminal-title">terminal</span>
        </div>
        <div class="terminal-body">
          <p><span class="terminal-prompt">$</span> whoami</p>
          <p class="terminal-output">Game Developer & CS Student</p>
          <p><span class="terminal-prompt">$</span> cat skills.txt</p>
          <p class="terminal-output">Unity · C# · Python · Computer Vision · AI</p>
          <p><span class="terminal-prompt">$</span> ls projects/</p>
          <p class="terminal-output">unity-game-demo/  ai-dance-recognition/  computer-vision/</p>
          <p><span class="terminal-prompt">$</span> <span class="terminal-cursor">_</span></p>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Projects -->
  <section class="section">
    <div class="container">
      <p class="section-label animate-slide-up">// Featured Work</p>
      <h2 class="animate-slide-up delay-1">Selected Projects</h2>

      <div class="projects-grid">
        <a href="/projects" class="project-card animate-slide-up delay-2">
          <div class="project-icon">🎮</div>
          <h3>Unity Game Demo</h3>
          <p>An interactive game prototype built with Unity and C#, featuring custom game mechanics and polished gameplay.</p>
          <div class="project-tags">
            <span class="tag">Unity</span>
            <span class="tag">C#</span>
            <span class="tag">Game Dev</span>
          </div>
        </a>

        <a href="/projects" class="project-card animate-slide-up delay-3">
          <div class="project-icon">💃</div>
          <h3>AI Dance Recognition</h3>
          <p>Real-time dance move recognition system using machine learning and pose estimation technology.</p>
          <div class="project-tags">
            <span class="tag">Python</span>
            <span class="tag">AI/ML</span>
            <span class="tag">MediaPipe</span>
          </div>
        </a>

        <a href="/projects" class="project-card animate-slide-up delay-4">
          <div class="project-icon">👁️</div>
          <h3>Computer Vision</h3>
          <p>Advanced computer vision project exploring image processing, object detection and visual intelligence.</p>
          <div class="project-tags">
            <span class="tag">Python</span>
            <span class="tag">OpenCV</span>
            <span class="tag">Deep Learning</span>
          </div>
        </a>
      </div>

      <div class="projects-cta animate-slide-up delay-5">
        <a href="/projects" class="btn-link">View all projects</a>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section">
    <div class="container">
      <div class="cta-card animate-slide-up">
        <h2>Let's work together.</h2>
        <p>Feel free to reach out for collaborations, projects, or just to say hi.</p>
        <a href="/contact" class="btn btn-primary">Get in Touch</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ===== Hero ===== */
  .hero {
    padding-top: 160px;
    padding-bottom: 100px;
    text-align: center;
  }

  .hero-greeting {
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--accent-blue);
    margin-bottom: 24px;
  }

  .hero-title {
    font-size: clamp(2.8rem, 7vw, 5rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-bottom: 24px;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: var(--text-secondary);
    margin-bottom: 48px;
  }

  .hero-actions {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ===== Terminal ===== */
  .terminal {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
    max-width: 640px;
    margin: 0 auto;
  }

  .terminal-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .terminal-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .terminal-title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-tertiary);
    margin-left: 8px;
  }

  .terminal-body {
    padding: 20px 22px;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.9;
  }

  .terminal-body p {
    color: var(--text-primary);
  }

  .terminal-prompt {
    color: var(--accent-blue);
    margin-right: 8px;
  }

  .terminal-output {
    color: var(--text-secondary) !important;
    padding-left: 20px;
  }

  .terminal-cursor {
    animation: blink 1s step-end infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* ===== Projects Grid ===== */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 48px;
  }

  .project-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 32px;
    text-decoration: none;
    transition: all var(--transition-smooth);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .project-card:hover {
    border-color: var(--border-light);
    transform: translateY(-6px);
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.4);
    color: var(--text-primary);
  }

  .project-icon {
    font-size: 2.5rem;
    line-height: 1;
  }

  .project-card h3 {
    font-size: 1.25rem;
    color: var(--text-primary);
  }

  .project-card p {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
    flex: 1;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 4px;
  }

  .projects-cta {
    text-align: center;
    margin-top: 48px;
  }

  /* ===== CTA Section ===== */
  .cta-section {
    padding: 80px 0 120px;
  }

  .cta-card {
    text-align: center;
    padding: 80px 40px;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
  }

  .cta-card h2 {
    margin-bottom: 16px;
  }

  .cta-card p {
    font-size: 1.1rem;
    margin-bottom: 32px;
    max-width: 480px;
    margin-left: auto;
    margin-right: auto;
  }

  @media (max-width: 768px) {
    .hero {
      padding-top: 120px;
      padding-bottom: 60px;
    }

    .projects-grid {
      grid-template-columns: 1fr;
    }

    .cta-card {
      padding: 48px 24px;
    }
  }
</style>
