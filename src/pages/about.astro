---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

const skills = {
  '编程语言': ['C#', 'Python', 'JavaScript', 'C++', 'GLSL'],
  '框架与工具': ['Unity', 'Unreal Engine', 'OpenCV', 'TensorFlow', 'Git'],
  '专业领域': ['游戏开发', '计算机视觉', '机器学习', 'Shader 编程'],
};
---

<Layout title="关于 — 游戏开发者">
  <section class="page-header">
    <div class="container">
      <p class="section-label animate-slide-up">// 关于</p>
      <h1 class="animate-slide-up delay-1">关于我。</h1>
    </div>
  </section>

  <section class="about-section">
    <div class="container">
      <div class="about-content">
        <!-- 个人简介 -->
        <div class="bio animate-slide-up delay-2">
          <p class="bio-text">
            我是一名计算机科学本科生，热衷于游戏开发和交互媒体。
            喜欢探索技术与创意的交汇点——从在 Unity 中构建沉浸式游戏体验，
            到训练能理解人体动作的 AI 模型。
          </p>
          <p class="bio-text">
            不写代码的时候，我可能在打游戏、折腾 Shader，
            或者在钻研计算机视觉和人工智能的最新研究。
          </p>
        </div>

        <!-- 技能 -->
        <div class="skills-section animate-slide-up delay-3">
          <h2>技能与技术</h2>
          <div class="skills-grid">
            {Object.entries(skills).map(([category, items]) => (
              <div class="skill-group">
                <h3 class="skill-category">{category}</h3>
                <div class="skill-tags">
                  {items.map((item) => (
                    <span class="tag">{item}</span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- 教育经历 -->
        <div class="education-section animate-slide-up delay-4">
          <h2>教育经历</h2>
          <div class="timeline">
            <div class="timeline-item">
              <div class="timeline-marker"></div>
              <div class="timeline-content">
                <h3>计算机科学</h3>
                <p class="timeline-subtitle">本科 · 在读</p>
                <p class="timeline-desc">
                  专注于游戏编程、计算机图形学和人工智能方向。
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- 兴趣爱好 -->
        <div class="interests-section animate-slide-up delay-5">
          <h2>兴趣爱好</h2>
          <div class="interests-grid">
            <div class="interest-item">
              <span class="interest-icon">🎮</span>
              <span>游戏设计</span>
            </div>
            <div class="interest-item">
              <span class="interest-icon">🤖</span>
              <span>AI & 机器学习</span>
            </div>
            <div class="interest-item">
              <span class="interest-icon">🎨</span>
              <span>Shader 艺术</span>
            </div>
            <div class="interest-item">
              <span class="interest-icon">📷</span>
              <span>计算机视觉</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    padding-top: 140px;
    padding-bottom: 40px;
  }

  .about-section {
    padding-bottom: 80px;
  }

  .about-content {
    max-width: 680px;
  }

  .bio {
    margin-bottom: 64px;
  }

  .bio-text {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.8;
    margin-bottom: 1em;
  }

  .bio-text:last-child {
    margin-bottom: 0;
  }

  /* Skills */
  .skills-section {
    margin-bottom: 64px;
  }

  .skills-section h2 {
    font-size: 1.5rem;
    margin-bottom: 32px;
  }

  .skills-grid {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .skill-category {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 12px;
    font-weight: 500;
  }

  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  /* Education */
  .education-section {
    margin-bottom: 64px;
  }

  .education-section h2 {
    font-size: 1.5rem;
    margin-bottom: 32px;
  }

  .timeline {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .timeline-item {
    display: flex;
    gap: 20px;
  }

  .timeline-marker {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent-gradient);
    flex-shrink: 0;
    margin-top: 6px;
  }

  .timeline-content h3 {
    font-size: 1.1rem;
    margin-bottom: 4px;
  }

  .timeline-subtitle {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-tertiary);
    margin-bottom: 8px;
  }

  .timeline-desc {
    font-size: 0.95rem;
    color: var(--text-secondary);
  }

  /* Interests */
  .interests-section h2 {
    font-size: 1.5rem;
    margin-bottom: 32px;
  }

  .interests-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .interest-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 20px;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    font-size: 0.95rem;
    color: var(--text-secondary);
    transition: all var(--transition-fast);
  }

  .interest-item:hover {
    border-color: var(--border-light);
    color: var(--text-primary);
  }

  .interest-icon {
    font-size: 1.3rem;
  }

  @media (max-width: 480px) {
    .interests-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
